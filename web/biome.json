{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["src/**", "e2e/**", "*.ts", "*.json", "!src/payload.json"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "css": { "linter": { "enabled": false } },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "useButtonType": "off",
        "useSemanticElements": "off"
      },
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noArrayIndexKey": "off" }
    }
  }
}
