#!/usr/bin/env bash
set -euo pipefail

# AGENTS.md: commit as Dan's personal identity; the pre-commit email hook rejects anything else.
git config --local user.name stancld
git config --local user.email daniel.stancl@gmail.com
git config --local blame.ignoreRevsFile .git-blame-ignore-revs

uv sync
uv run pre-commit install-hooks

# The diary page is a Vite + React app; .amp/services.yaml runs its dev server.
(cd web && bun install --frozen-lockfile)
